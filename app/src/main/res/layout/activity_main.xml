<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:text="THÔNG TIN SINH VIÊN"
            android:textColor="#1565C0"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Student Information"
            android:textColor="#78909C"
            android:textSize="14sp" />

        <!-- Thông tin -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvMaSinhVien"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mã sinh viên"
                android:textColor="#263238"
                android:textSize="17sp"
                android:paddingBottom="14dp" />

            <TextView
                android:id="@+id/tvHoTen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Họ tên"
                android:textColor="#263238"
                android:textSize="17sp"
                android:paddingBottom="14dp" />

            <TextView
                android:id="@+id/tvLop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lớp"
                android:textColor="#263238"
                android:textSize="17sp"
                android:paddingBottom="14dp" />

            <TextView
                android:id="@+id/tvTuoi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tuổi"
                android:textColor="#263238"
                android:textSize="17sp"
                android:paddingBottom="14dp" />

            <TextView
                android:id="@+id/tvKhoa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Khoa"
                android:textColor="#263238"
                android:textSize="17sp"
                android:paddingBottom="14dp" />

            <TextView
                android:id="@+id/tvDiem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Điểm"
                android:textColor="#263238"
                android:textSize="17sp" />

        </LinearLayout>

        <!-- Trạng thái -->
        <TextView
            android:id="@+id/tvTrangThai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="#E8F5E9"
            android:padding="16dp"
            android:text="Trạng thái: ĐẠT"
            android:textColor="#2E7D32"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Xếp loại -->
        <TextView
            android:id="@+id/tvXepLoai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFF3E0"
            android:padding="16dp"
            android:text="Xếp loại: GIỎI"
            android:textColor="#E65100"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Button -->
        <Button
            android:id="@+id/btnHienThi"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="HIỂN THỊ THÔNG TIN"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>